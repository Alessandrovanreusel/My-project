{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    },
    "UnityMCP": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "mcpforunityserver==10.2.0",
        "mcp-for-unity"
      ],
      "env": {
        "UNITY_MCP_SKIP_STARTUP_CONNECT": "1"
      }
    }
  }
}

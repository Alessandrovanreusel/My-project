{
  "mcpServers": {
    "UnityMCP": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "mcpforunityserver==10.1.0", "mcp-for-unity"]
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "atlassian": {
      "type": "http",
